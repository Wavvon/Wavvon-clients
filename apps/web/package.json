{
  "name": "wavvon-web",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:hub": "tsc && vite build --mode hub --outDir dist-hub",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:live": "playwright test --project=live --workers=1",
    "test:e2e:desktop": "playwright test --project=desktop --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "check-i18n": "tsx ../../packages/i18n/check-coverage.ts",
    "check-hardcoded": "node ../../packages/i18n/find-hardcoded.mjs",
    "check-hub-build": "node scripts/check-hub-build.mjs",
    "check-untranslated": "node ../../packages/i18n/find-untranslated.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^1.6.0",
    "@types/dompurify": "^3.2.0",
    "@wavvon/core": "workspace:*",
    "@wavvon/i18n": "workspace:*",
    "@wavvon/ui": "workspace:*",
    "dompurify": "^3.4.17",
    "i18next": "^24.2.3",
    "i18next-icu": "^2.7.0",
    "idb": "^8.0.4",
    "intl-messageformat": "^11.2.15",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.7.4"
  },
  "devDependencies": {
    "@playwright/test": "~1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
